{
	"info": {
		"_postman_id": "a9b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "RikkeiBank API - Microservices Ecosystem",
		"description": "Complete Postman Collection for RikkeiBank Microservices through Spring Cloud API Gateway (Port 8080).\n\nFeatures Included:\n1. Identity & Security: JWT Auth, Refresh Token (Seamless Session), Force-logout / Revoke Token.\n2. Catalog & Customer: Customer & Staff CRUD, Redis Distributed Caching (Cache-Aside).\n3. Catalog & Accounts: Account Types CRUD, Bank Accounts, Balance Management.\n4. Core Business: Distributed Transaction with SAGA Orchestrator (Happy path & Compensating Rollback), Resilience4j Circuit Breaker.\n5. Event-Driven Notifications: Kafka Consumer / Balance Change Alerts.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "teller_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_token",
